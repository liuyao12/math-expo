  "corrections": [
    {
      "section": 2,
      "note": "Comparison translation omits the base in the progression; Latin includes it."
    },
    {
      "section": 11,
      "note": "Latin multiplier 284, not the comparison translation’s 288."
    },
    {
      "section": 22,
      "note": "Consecutive even powers; odd powers repeat one other remainder."
    },
    {
      "section": 26,
      "note": "Add odd-prime hypothesis when distinguishing +1 and -1."
    },
    {
      "section": 31,
      "note": "Divide exponent by lambda, as in Latin; comparison has p."
    },
    {
      "section": 33,
      "note": "Second printed §32 numbered §33 in consecutive sequence."
    },
    {
      "section": 37,
      "note": "Reduce a negative exponent difference to a nonnegative exponent modulo the period."
    },
    {
      "section": 44,
      "note": "Normalize exponent letter in the inequality to lambda."
    },
    {
      "section": 55,
      "note": "Retain exception p divides a-1 from Theorem 15."
    },
    {
      "section": 56,
      "note": "Exception is p divides a-1, not merely p equals a-1."
    },
    {
      "section": 58,
      "note": "Universal divisibility claim fails for a congruent to1 modulo q; exception is discussed in §59."
    },
    {
      "section": 60,
      "note": "Composite-exponent remark is not a complete factorization algorithm."
    },
    {
      "section": 72,
      "note": "Reset exact finite sum; original conclusion is divisible, not not divisible as in comparison; include m=1 constant case."
    },
    {
      "section": 73,
      "note": "Original says divisible for both prescribed inputs; comparison has contrary wording in second assertion."
    },
    {
      "section": 78,
      "note": "Already proposed elsewhere, not now proposed; no precise earlier title identified."
    },
    {
      "section": 53,
      "note": "The final divisor assertion needs the least returning exponent; a larger returning exponent need not divide p-1."
    }
  ],
  "scope": "Positive integer bases, prime p, nonzero remainders, positive integers n dividing p-1; no abstract group or composite-modulus generalization. Six written proofs, no proof-assistant verification.",
  "illustrations": "Five editorial diagrams/tables. Multiplication cycle, disjoint lists, and finite-difference values are computed and checked in check-euler-1761.mjs."
}
